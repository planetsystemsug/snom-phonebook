# Generate hashes with: php -r "echo password_hash('choose-a-password', PASSWORD_DEFAULT), PHP_EOL;"
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Set both values to protect /phonebook.xml.php with HTTP Basic authentication.
PHONEBOOK_AUTH_USER=
PHONEBOOK_AUTH_PASSWORD_HASH=

